# Genkit / Gemini
GEMINI_API_KEY=

# SAP Business One — Service Layer (solo servidor, no exponer al cliente)
SAP_SERVICE_LAYER_BASE_URL=https://sl-sap.acerosytrefilados.com/b1s/v1
SAP_SERVICE_LAYER_USER=
SAP_SERVICE_LAYER_PASSWORD=
SAP_SERVICE_LAYER_DEFAULT_COMPANY_DB=ATNPRUEBAS

# Opcionales
SAP_SERVICE_LAYER_TIMEOUT_MS=30000
SAP_SERVICE_LAYER_MAX_RETRIES=3
SAP_SERVICE_LAYER_SESSION_TTL_MS=1800000
SAP_SERVICE_LAYER_RETRY_BASE_DELAY_MS=500

# PostgreSQL (local o Docker)
DATABASE_URL=postgresql://admin:password123@db:5432/smart_collections

# Brevo (Email Transaccional)
# Obtén tu API key en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@recupera-ai-pro.com
BREVO_FROM_NAME=Recupera AI Pro
