# SAP Business One — Service Layer (solo servidor, no exponer al cliente)
SAP_SERVICE_LAYER_BASE_URL=https://sl-sap.acerosytrefilados.com/b1s/v1
SAP_SERVICE_LAYER_USER=
SAP_SERVICE_LAYER_PASSWORD=
SAP_SERVICE_LAYER_DEFAULT_COMPANY_DB=ATNPRUEBAS

# Opcionales
SAP_SERVICE_LAYER_TIMEOUT_MS=30000
SAP_SERVICE_LAYER_MAX_RETRIES=3
SAP_SERVICE_LAYER_SESSION_TTL_MS=1800000
SAP_SERVICE_LAYER_RETRY_BASE_DELAY_MS=500

# PostgreSQL — URL de conexión que usa la aplicación (src/lib/db)
DATABASE_URL=postgresql://admin:password123@db:5432/crediat

# Brevo (Email Transaccional)
# Obtén tu API key en https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@crediat.app
BREVO_FROM_NAME=Crediat

# Infraestructura Docker — credenciales del contenedor PostgreSQL (solo para `docker compose`)
# Deben coincidir con las de DATABASE_URL. En producción, sobrescribir con valores seguros.
POSTGRES_DB=crediat
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_ENDPOINT=minio
MINIO_PORT=9000
REDIS_URL=redis://redis:6379

# OpenRouter (IA)
# Obtén tu API key en https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Proveedor de IA: 'openrouter' (default) o 'foundry'
AI_PROVIDER=openrouter

# Microsoft Foundry (Azure AI Foundry) — solo si AI_PROVIDER=foundry
# Endpoint del proyecto Foundry (Serverless endpoint)
AZURE_FOUNDRY_BASE_URL=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=

# Observabilidad (OpenTelemetry) — opcional
# LOG_LEVEL=debug|info|warn|error (default: info)
LOG_LEVEL=info
# Endpoint OTLP para tracing (ej. OpenTelemetry Collector). Si se omite, se desactiva el tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=crediat

# MinIO (Object Storage) — configuración de la app
MINIO_BUCKET=crediat
MINIO_USE_SSL=false
