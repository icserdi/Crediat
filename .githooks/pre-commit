#!/usr/bin/env sh
set -e

# Valida calidad de código antes de permitir el commit.
# Corre lint, typecheck y tests. Si algo falla, aborta el commit.

echo "🔍 Pre-commit: ejecutando validaciones..."

echo "→ Lint"
npm run lint

echo "→ Typecheck"
npm run typecheck

echo "→ Tests"
npm test

echo "✅ Pre-commit: validaciones completadas correctamente."
